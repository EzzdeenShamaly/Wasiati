# --- Node / backend ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.pnpm-store/

# --- Env / secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.p8

# --- Dart / Flutter ---
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
app/**/build/
**/.fvm/

# Flutter generated (kept out of VCS; regenerated by build_runner / flutterfire)
**/*.g.dart
**/*.freezed.dart
**/*.config.dart
**/firebase_options.dart
**/google-services.json
**/GoogleService-Info.plist

# --- OpenAPI generated client is committed, but its build junk is not ---
app/packages/api_client/.dart_tool/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Local AI agent worktrees (never commit) ---
# `.claude/worktrees/*` are full nested checkouts an agent spins up for isolated work;
# each carries its own real .env with live secrets. They are local scratch, not source,
# and matched at any depth so a stray `git add -A` from the repo root OR from backend/
# can never stage them (or their secrets). Nothing under .claude/ is tracked.
.claude/

# --- Infra / local data volumes ---
infra/**/data/
*.log

# Golden capture artifacts (dev screenshotting tool)
app/apps/wasiati/test/*_capture*.png
app/apps/wasiati/test/cap_*.png
app/apps/wasiati/test/landing_dark.png

# --- Design handoff files (proprietary design-tool format, reference only) ---
# These must NEVER enter the build/lint scope — see CLAUDE.md. The package lives
# outside the repo (Downloads\RA Business\Wasiati.com DV2.1\Exports\wasiati-dev-handoff);
# this is a backstop in case files get copied in.
*.dc.html
**/Wasiati Prototype.html
**/VISUAL REFERENCE*.html
