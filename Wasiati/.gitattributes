# Normalize all text to LF in the repo (checked out per-platform).
# This governs line endings for the whole team + CI, instead of relying on
# each developer's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run correctly
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.keystore binary
*.p8   binary
*.pem  binary
*.zip  binary

# Generated code: collapse in diffs, exclude from language stats
*.g.dart        linguist-generated=true
*.freezed.dart  linguist-generated=true
*.config.dart   linguist-generated=true
app/packages/api_client/lib/** linguist-generated=true

# Lockfiles: keep but don't show noisy diffs
pnpm-lock.yaml -diff
pubspec.lock   -diff
