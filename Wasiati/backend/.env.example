# Which regional deployment this instance serves: US | CA | KSA.
# Each region runs its OWN instance of this backend pointed at its OWN database —
# do not point a KSA instance's DATABASE_URL at a Canadian or US database, or vice
# versa. Personal data for a region's users must be stored in that region (data
# residency): the app refuses to boot without a valid REGION, and refuses to create
# a user whose region differs from this one.
#
# DEPLOYMENT NOTE: the boot gate reads REGION before .env is loaded, so in a
# container it must be a REAL process env var (ECS task definition `environment`),
# not only a line in this file. The production image ships no .env at all.
REGION=US
PORT=4000

# The MARKET regions this deployment accepts signups for (comma-separated). REQUIRED in
# production — env.validation refuses to boot without it, so a stack can never silently
# collapse to serving only REGION and refuse every other market. In dev it defaults to
# just REGION. Distinct from REGION because the launch topology is ONE stack serving
# every market — no market legally requires in-country storage (plan, 28 Jul 2026) —
# while the per-region shard model stays intact for later. Launch: US,CA,KSA on the
# single stack. When a dedicated KSA stack exists, remove KSA here and new Saudi
# signups are refused with a pointer to the KSA service. A user's region (their
# pricing, currency, KYC rail) is derived server-side from their address country at
# registration — never from the client's region field.
SERVED_REGIONS=US,CA,KSA

# How many proxies WE operate in front of the app. Prod behind Cloudflare + ALB: 2.
# Bare ALB: 1. Local dev: leave unset (0 — no proxy trusted). This is a hop COUNT,
# never `true`: trusting the whole X-Forwarded-For chain lets any client forge its
# IP, and req.ip is written into will signature certificates and audit logs.
TRUST_PROXY_HOPS=

# Currencies enabled on the Stripe account, comma-separated.
# Users are billed in their own region's currency (US=USD, CA=CAD, KSA=SAR).
# If a region's currency is NOT listed here, that region is billed in USD instead
# and the price is CONVERTED at the currency's fixed USD peg (never relabelled).
# Only pegged currencies can fall back — a floating currency (e.g. CAD) raises
# rather than being charged at a guessed FX rate.
# Leave unset to treat every currency as enabled (the correct value once the
# merchant account is fully configured).
PAYMENT_ENABLED_CURRENCIES=
# Comma-separated allowed web origins. Prod: the landing + app subdomains.
# e.g. https://app.wasiati.com,https://wasiati.com
# The LANDING must be listed too, not just the app: it fetches GET /pricing for live
# prices (landing/public/pricing.js). :8080 is its local-preview origin per landing/README.md.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Session cookie (web). In prod set COOKIE_DOMAIN=.wasiati.com so the httpOnly refresh
# cookie is shared between app.wasiati.com and api.wasiati.com; COOKIE_SECURE=true on HTTPS.
COOKIE_DOMAIN=
# REQUIRED to be "true" in production (env.validation refuses to boot otherwise): the
# refresh cookie is a 30-day bearer credential and this flag defaults to OFF, so
# forgetting it would silently weaken sessions rather than fail.
COOKIE_SECURE=false

# How long a session may sit IDLE before the user must sign in again. Enforced on the
# refresh path: rotation mints a new token on every refresh, so the age of the token a
# client presents is the time since that session last did anything. Independent of
# REFRESH_TOKEN_TTL_DAYS, which is the ABSOLUTE ceiling on a session. 0 disables it.
SESSION_IDLE_TIMEOUT_MINUTES=60

# Database (region-local — see note above)
DATABASE_URL=postgresql://wasiati:password@localhost:5432/wasiati_us
REDIS_URL=redis://localhost:6379

# Sessions / JWT
SESSION_SECRET=replace-with-a-long-random-string

# Google Sign-In. GOOGLE_CLIENT_IDS is a comma-separated list of every OAuth client id
# whose id_tokens we accept (web + iOS + Android). GOOGLE_CLIENT_ID is the web one and
# is used as a fallback audience if GOOGLE_CLIENT_IDS is unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Apple Sign-In. APPLE_CLIENT_IDS is a comma-separated list of accepted audiences:
# the Services ID (web/Android) and the app Bundle ID (native iOS). APPLE_CLIENT_ID
# is the Services ID and acts as a fallback audience if APPLE_CLIENT_IDS is unset.
# TEAM_ID/KEY_ID/PRIVATE_KEY are the Sign-in key, required for token revocation
# (App Store mandates it when offering Sign in with Apple).
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Microsoft Sign-In (Entra ID / Azure AD app registration)
# MICROSOFT_CLIENT_ID = the Application (client) ID from the Azure app registration.
# MICROSOFT_TENANT: a specific tenant GUID to lock to one org, or `common`
# (any Microsoft account) / `organizations` / `consumers`. Defaults to `common`.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common

# Twilio (SMS + WhatsApp OTP delivery)
#
# TWILIO_WHATSAPP_FROM is the cost lever for Saudi Arabia: a +966 SMS costs ~$0.1949 —
# 15.6x a US one and the most expensive thing this product does per login — while the same
# message over WhatsApp is roughly $0.045. Set it and Saudi numbers route to WhatsApp
# automatically (auth.service mfaChannel); leave it blank and nothing changes, because a
# saving that cannot be delivered is worse than the cost.
#
# BEFORE it carries real traffic: Twilio requires business-initiated WhatsApp messages to
# use a PRE-APPROVED template. Plain text only works inside a 24h customer-initiated
# window, so register an authentication template on the sender first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Payments: Stripe -----------------------------------------------------------
# Test keys are sk_test_/pk_test_; live keys sk_live_/pk_live_. Without a secret
# key the app still boots — payment endpoints fail with a clean 400 instead.
STRIPE_SECRET_KEY= 
STRIPE_PUBLISHABLE_KEY= 

# Signing secret (whsec_...) used to verify the `Stripe-Signature` header on webhooks.
# The SAME two variables also drive Stripe Identity (KYC) — one Stripe account, see
# the KYC section below.
STRIPE_WEBHOOK_SECRET=
# Comma-separated hosts the post-payment success/cancel URLs must be on (https).
# Prevents checkout being used as an open-redirect. Unset = permissive (dev only), and
# REQUIRED in production — env.validation refuses to boot without it, because unset the
# check accepts ANY client-supplied return URL rather than failing.
# e.g. app.wasiati.com,wasiati.com
PAYMENT_RETURN_HOSTS=

# There are NO price/product ids (Stripe Billing is deliberately unused):
# PricingPlan.unitAmount in the database is the price of record, and the
# subscription billing cycle is run by SubscriptionsService.

# Referral programme: max rewarded referrals per calendar year (default 100).
REFERRAL_YEARLY_CAP=100

# --- KYC ----------------------------------------------------------------------
# US/CA document verification uses STRIPE IDENTITY (docs/DECISIONS.md §13, which
# supersedes the §7 choice of Sumsub). It needs NO new variables: it reuses
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET above, because it is the same Stripe
# account. BOTH are required — the outcome of a verification arrives only by signed
# webhook, so a server that cannot verify a signature could never legitimately mark
# anyone verified.
#
# Provider selection at boot: Stripe Identity if both keys are set → else Sumsub if
# all three SUMSUB_* are set → else an adapter that returns a clean 503. A blank or
# placeholder key counts as absent, so a half-configured environment degrades to the
# 503 instead of crashing or approving anyone.
#
# Webhook: point the Stripe Dashboard at POST /identity/webhook and subscribe to
# identity.verification_session.{verified,requires_input,processing,created}. It is a
# SEPARATE endpoint from /payments/webhook and can use its own signing secret only if
# you also split the variable — today they share STRIPE_WEBHOOK_SECRET.
#
# Where Stripe returns the user after the hosted flow. Defaults to
# ${APP_BASE_URL}/identity/verified; set only to override that path.
STRIPE_IDENTITY_RETURN_URL=
#
# KSA/QA are unaffected — they use Nafath (see NAFATH_* below).

# Ameen — AI conversational intake (Premium+ tier), on Google Gemini.
# Empty => /ai-intake returns a clean 503 and the app falls back to the guided form,
# so an unconfigured deploy degrades rather than breaks. Key: Google AI Studio.
# GEMINI_MODEL is optional (default gemini-2.5-flash — chosen for cost, which is why
# this moved off Anthropic; see DECISIONS §24). GEMINI_BASE_URL is for proxies/tests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=

# Authenticator-app (TOTP) second factor. Stored secrets are sealed with AES-256-GCM
# under a key HKDF-derived from this value, or from SESSION_SECRET when it is unset.
#
# REQUIRED IN PRODUCTION — the app refuses to boot without it, deliberately. Leaving it
# unset welds two unrelated rotation schedules together: rotate SESSION_SECRET, which is
# the correct response to any suspected leak, and every enrolled authenticator app stops
# verifying at once, for every user, with no error explaining why. Each of them then has
# to burn a backup code to re-enrol.
#
# Set it BEFORE the first user enrols. It cannot be introduced afterwards: adding it
# later changes the derived key and breaks exactly the secrets it exists to protect.
# Optional in development, where the SESSION_SECRET fallback is a convenience.
MFA_SECRET_KEY=

# Passkeys (Face ID / Touch ID / Windows Hello / Chrome platform authenticator).
# ORIGIN is compared EXACTLY by WebAuthn — the app runs on app.wasiati.com, and the
# old value here (https://wasiati.com) made every passkey registration and login
# fail against production. RP_ID stays the registrable domain so one passkey works
# across subdomains.
PASSKEY_RP_ID=wasiati.com
PASSKEY_ORIGIN=https://app.wasiati.com

# --- Email (SES over SMTP) ----------------------------------------------------
# Read by notifications.service.ts. UNSET, EMAIL IS SILENTLY DROPPED: sendEmail()
# logs a warning and returns false — no verification mails, no password resets, no
# trustee invitations, no death-claim links. These six were previously read by the
# code but documented nowhere, which is exactly how a production deploy ships
# without them. SES sandbox note: new accounts send only to verified addresses
# (200/day) until production access is granted — request it ~24h before cutover.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wasiati <no-reply@wasiati.com>

# Vault encryption — THERE IS NO SERVER-SIDE KEY, and that is deliberate.
#
# The vault is end-to-end encrypted IN THE CLIENT: a per-item AES-256-GCM data key,
# wrapped by a KEK derived from the user's passphrase (PBKDF2). The server stores only
# ciphertext and the wrapped key and cannot decrypt either — which is what makes the
# vault hold against a breach, a subpoena, or us.
#
# Two consequences, both intended:
#   · A user who forgets their vault passphrase CANNOT be helped. Recovery is impossible
#     by design, not by omission — say so in the UI before they store anything.
#   · There is no vault key to rotate, escrow or lose. A VAULT_ENCRYPTION_KEY variable
#     used to be documented here as a "server-side wrapping key"; NOTHING in the code
#     has ever read it (verified: no reader, and no server-side cipher anywhere), so
#     setting it protected nothing and implied a server-side control that does not exist.

# --- Phase 2 (leave blank for now) ---
NAFATH_CLIENT_ID=
NAFATH_CLIENT_SECRET=
NAFATH_REDIRECT_URI=
MOI_API_BASE_URL=
MOI_API_KEY=

# Nafath (KSA national identity / KYC — National Information Center onboarding).
# Not self-serve: credentials + exact endpoints are issued at government onboarding.
# Empty => /identity/nafath/* returns a clean 503.
NAFATH_BASE_URL=
NAFATH_API_KEY=
NAFATH_APP_ID=
NAFATH_APP_KEY=
NAFATH_CALLBACK_SECRET=

# Sumsub (US/CA document + selfie KYC). SUPERSEDED by Stripe Identity (DECISIONS §13)
# and kept only as a fallback: it is used ONLY when the STRIPE_* keys above are absent.
# All three of APP_TOKEN, SECRET_KEY and WEBHOOK_SECRET must be set, or the app falls
# back to an adapter that returns a clean 503 — it never approves anyone silently.
# Webhook: point Sumsub at POST /identity/webhook. Its digest algorithm is read from
# the x-payload-digest-alg header; prefer HMAC_SHA256_HEX in the dashboard.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_BASE_URL=https://api.sumsub.com

# Zakat gold price: LIVE by default. GoldPriceService refreshes spot gold from a
# keyless public feed every 6 hours (gold-api.com + open.er-api.com for FX — neither
# takes an API key, so there is nothing to provision or leak) and refuses to serve a
# price older than 72 h.
#
# The per-gram values below are the MANUAL FALLBACK for a dead feed, in MINOR units
# of each region's currency (e.g. SAR 500.00/g -> 50000). Niṣāb is 85 g of gold, so
# this is the line between owing zakat and owing nothing. When the live price is
# stale AND the fallback is unset, /zakat/estimate returns 503 rather than guess.
ZAKAT_GOLD_PRICE_PER_GRAM_SAR=
ZAKAT_GOLD_PRICE_PER_GRAM_USD=
ZAKAT_GOLD_PRICE_PER_GRAM_CAD=
# Override the feed endpoints only if a feed dies or you self-host a proxy.
ZAKAT_GOLD_FEED_URL=
ZAKAT_FX_FEED_URL=

# --- Object storage (uploads) -------------------------------------------------
# Direct-to-storage presigned uploads for ID documents (and future user files).
# One bucket PER REGION (data residency). Without STORAGE_BUCKET, /files/presign
# returns a clean 503 — no upload silently no-ops. Works with AWS S3, Cloudflare R2,
# or MinIO in dev (set STORAGE_ENDPOINT + STORAGE_FORCE_PATH_STYLE=true).
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# Omit the keys on AWS to use the instance IAM role; set them for MinIO/R2.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Hours an unconfirmed upload may live before the nightly reaper deletes it.
UPLOAD_ORPHAN_GRACE_HOURS=24

# DEV ONLY: echo OTP codes in responses (witness/trustee/death-request e2e without SMS).
# NEVER set to true in production.
OTP_DEV_ECHO=false

# Death-certificate upload host allow-list (comma-separated), e.g. your S3/CDN domain.
# A submitted certificate URL must be https AND on one of these hosts, so an admin
# reviewer is never lured into fetching an internal/attacker URL (SSRF). Leave unset
# until the upload pipeline exists — https is still enforced by the DTO.
DEATH_CERT_URL_HOST=

# NODE_ENV: set to "production" in prod. Gates Swagger /docs (never served in prod).
NODE_ENV=development

# Hours the death-claim safety-check window must elapse (since the check SMS was
# sent to the deceased's own number) before an admin can RELEASE the will. Gives a
# living account-holder time to respond. Default 72.
DEATH_CLAIM_SAFETY_WINDOW_HOURS=72

# Posthumous data purge: days after a death claim is released before the deceased's
# data is hard-deleted by the daily job. Default 90.
DATA_RETENTION_DAYS=90

# There is no hosted billing portal — /payments/subscription{,/cancel,/resume} are
# the portal. Cancelling is never blocked: a burial plan is prepayment, so cancelling
# stops its contributions and makes them refundable (see docs/DECISIONS.md §6).

# Malware-scan quarantine for uploads (docs/UPLOAD_SECURITY_AWS.md). When 'true', a
# new upload is held (scanStatus PENDING) and not served until GuardDuty Malware
# Protection for S3 → EventBridge → POST /files/scan-callback marks it CLEAN. The
# callback is authenticated by HMAC-SHA256 over the JSON body with this secret.
MALWARE_SCAN_ENABLED=false
FILES_SCAN_WEBHOOK_SECRET=

# Global rate limit. Unset in production = 100 requests / 60s.
# Raise ONLY for local integration testing (the suite exceeds 100 req/min unaided).
# THROTTLE_LIMIT=100000
# THROTTLE_TTL_MS=60000

# Base URL of the Flutter app. EVERY link we put in SMS/email is built from this
# (common/app-url.ts): trustee + witness confirmation, death-claim invites, the heir
# portal, retention notices, referrals. REQUIRED in production — the app refuses to boot
# without it, because a wrong link here is invisible: the message sends, the recipient
# taps, and nothing happens. (APP_WEB_URL is a deprecated alias.)
APP_BASE_URL=https://app.wasiati.com

# Login second-factor limits. Unset in production = 30s between codes, 5 per hour per
# destination. Raise ONLY for local testing — a burned cap reads as a rejected password.
# LOGIN_MFA_COOLDOWN_MS=0
# LOGIN_MFA_MAX_PER_WINDOW=1000
